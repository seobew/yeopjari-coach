<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vehicle SDK: 조회 권한만 (TurnSignal=CAR_LIGHTS, Gear=CAR_DRIVE, SeatBelt=CAR_SEATS) -->
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />

    <!-- NaviHelper SDK -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:name=".ProbeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <activity
            android:name=".CoachActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:exported="true">
            <!-- 주행 중 사용 허용(Android Automotive 표준 선언). 실측: 없으면 기어 D에서 플랫폼이 "주행 중에는 사용할 수 없습니다"로 앱을 덮는다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density"
            android:exported="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

    </application>

</manifest>
